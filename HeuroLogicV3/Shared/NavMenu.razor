<div class="nav-menu">
    <div class="nav-brand-row">
        <a class="nav-brand" href="/">
            HeuroLogicV3
        </a>
        <button type="button"
                class="nav-toggle"
                title="Toggle navigation"
                aria-label="Toggle navigation"
                aria-controls="app-navigation"
                aria-expanded="@(!_menuCollapsed)"
                @onclick="ToggleNavMenu">
            <span class="oi oi-menu" aria-hidden="true"></span>
        </button>
    </div>
    <div id="app-navigation"
         class="nav-links @(_menuCollapsed ? "is-collapsed" : "")">
        <nav aria-label="Main navigation"
             @onclick="CloseNavMenu">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span>
                Home
            </NavLink>
            <NavLink class="nav-link" href="/user-guide">
                <span class="oi oi-lightbulb" aria-hidden="true"></span>
                User Guide
            </NavLink>
            <NavLink class="nav-link" href="/make-decision">
                <span class="oi oi-list-rich" aria-hidden="true"></span>
                Make Decision
            </NavLink>

            <NavLink class="nav-link" href="/history-decisions">
                <span class="oi oi-book" aria-hidden="true"></span>
                History Decisions
            </NavLink>
            <NavLink class="nav-link" href="/about">
                <span class="oi oi-info" aria-hidden="true"></span>
                About
            </NavLink>
        </nav>
    </div>
</div>

@code {
    private bool _menuCollapsed = true;

    private void ToggleNavMenu()
    {
        _menuCollapsed = !_menuCollapsed;
    }

    private void CloseNavMenu()
    {
        _menuCollapsed = true;
    }
}
